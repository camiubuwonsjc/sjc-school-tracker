<file path="src/pages/Rooms.jsx">
import React, { useState, useEffect, useMemo } from 'react';
import { createPortal } from 'react-dom';
import { useLocation } from 'react-router-dom';
import { supabase } from '../data/supabaseClient';
import { api } from '../services/api';
import BlastACModal from '../components/BlastACModal';
import { 
  Building2, 
  CheckCircle2, 
  Power, 
  Lightbulb, 
  Lock, 
  Users, 
  X, 
  Check, 
  Snowflake,
  Search
} from 'lucide-react';

export default function Rooms({ rooms = [], setRooms, user, assignments = {} }) {
  const location = useLocation();
  const [selectedFloor, setSelectedFloor] = useState(1);
  const [searchQuery, setSearchQuery] = useState('');
  const [activeModalRoom, setActiveModalRoom] = useState(null);
  const [isSaving, setIsSaving] = useState(false);
  const [toastMessage, setToastMessage] = useState('');
  const [showBlastModal, setShowBlastModal] = useState(false);

  // Form states for the room modal
  const [statusVal, setStatusVal] = useState('pending');
  const [recleanReasonVal, setRecleanReasonVal] = useState('');
  const [acVal, setAcVal] = useState(true);
  const [lightsVal, setLightsVal] = useState(true);
  const [doorVal, setDoorVal] = useState(true);
  const [hasStudentsVal, setHasStudentsVal] = useState(false);
  const [notesVal, setNotesVal] = useState('');

  // Keeps floor selection intact across updates
  useEffect(() => {
    if (location.state?.targetFloor) {
      setSelectedFloor(Number(location.state.targetFloor));
    }
    if (location.state?.targetRoomId) {
      const found = rooms.find((r) => String(r.id) === String(location.state.targetRoomId));
      if (found) {
        handleOpenRoomModal(found);
      }
    }

    // Clean browser history state so background sync won't re-trigger
    if (location.state?.targetFloor || location.state?.targetRoomId) {
      window.history.replaceState({}, document.title);
    }
  }, [location.state, rooms]);

  const handleOpenRoomModal = (room) => {
    setActiveModalRoom(room);
    setStatusVal(room.status || 'pending');
    setRecleanReasonVal(room.recleanReason || '');
    setAcVal(room.acChecked ?? true);
    setLightsVal(room.lightsChecked ?? true);
    setDoorVal(room.doorChecked ?? true);
    setHasStudentsVal(room.hasStudents ?? false);
    setNotesVal(room.notes || '');
  };

  const handleCloseRoomModal = () => {
    setActiveModalRoom(null);
  };

  const handleSaveInspection = async () => {
    if (!activeModalRoom) return;
    setIsSaving(true);

    const nowTime = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    const staffName = user?.name || activeModalRoom.staff || 'Staff';

    const updatedData = {
      status: statusVal,
      staff: staffName,
      last_cleaned: nowTime,
      reclean_reason: statusVal === 'needs_reclean' ? recleanReasonVal : null,
      ac_checked: acVal,
      lights_checked: lightsVal,
      door_checked: doorVal,
      has_students: hasStudentsVal,
      notes: notesVal
    };

    // Optimistic local state update for instant UI feedback
    if (setRooms) {
      setRooms((prev) =>
        prev.map((r) =>
          r.id === activeModalRoom.id
            ? {
                ...r,
                status: statusVal,
                staff: staffName,
                lastCleaned: nowTime,
                recleanReason: statusVal === 'needs_reclean' ? recleanReasonVal : null,
                acChecked: acVal,
                lightsChecked: lightsVal,
                doorChecked: doorVal,
                hasStudents: hasStudentsVal,
                notes: notesVal
              }
            : r
        )
      );
    }

    try {
      // Routed through Node.js & Express MVC Backend API
      await api.updateRoom(activeModalRoom.id, updatedData);
      setToastMessage(`Room ${activeModalRoom.id} inspection recorded via Express API!`);
      setTimeout(() => setToastMessage(''), 3000);
      handleCloseRoomModal();
    } catch (err) {
      console.warn('Express API unavailable, attempting client fallback:', err);
      try {
        await supabase.from('rooms').update(updatedData).eq('id', activeModalRoom.id);
        setToastMessage(`Room ${activeModalRoom.id} inspection recorded (offline mode)!`);
        setTimeout(() => setToastMessage(''), 3000);
        handleCloseRoomModal();
      } catch (fallbackErr) {
        console.error('All update paths failed:', fallbackErr);
      }
    } finally {
      setIsSaving(false);
    }
  };

  // Filter classrooms by selected floor & search query
  const floorRooms = useMemo(() => {
    return rooms.filter((r) => {
      const matchesFloor = searchQuery.trim() !== '' ? true : r.floor === selectedFloor;
      const q = searchQuery.toLowerCase().trim();
      const matchesSearch =
        !q ||
        String(r.id).toLowerCase().includes(q) ||
        (r.staff && r.staff.toLowerCase().includes(q)) ||
        (r.status && r.status.toLowerCase().includes(q)) ||
        (r.notes && r.notes.toLowerCase().includes(q));

      return matchesFloor && matchesSearch;
    });
  }, [rooms, selectedFloor, searchQuery]);

  const floorStatsRooms = rooms.filter((r) => r.floor === selectedFloor);
  const floorCleaned = floorStatsRooms.filter((r) => r.status === 'cleaned' || r.status === 'verified').length;

  return (
    <div className="p-4 space-y-3.5 pb-28 text-slate-800">
      
      {/* Floating Notification (Toast Portal) */}
      {toastMessage && createPortal(
        <div className="fixed top-20 inset-x-0 z-[150] max-w-md mx-auto px-4 pointer-events-none animate-toast">
          <div className="pointer-events-auto p-3 bg-emerald-50/95 backdrop-blur-sm border border-emerald-300 text-emerald-800 text-xs font-semibold rounded-2xl flex items-center gap-2.5 shadow-xl">
            <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0" />
            <span className="flex-1 font-medium">{toastMessage}</span>
          </div>
        </div>,
        document.body
      )}

      {/* Header & Quick Stats */}
      <div className="flex items-center justify-between">
        <div>
          <h2 className="text-base font-bold text-slate-900 leading-tight">
            Dimasalang Inspection
          </h2>
          <p className="text-[11px] text-slate-400">
            35 Classrooms across 7 Floors
          </p>
        </div>

        <button
          type="button"
          onClick={() => setShowBlastModal(true)}
          className="flex items-center gap-1.5 px-2.5 py-1.5 bg-cyan-50 hover:bg-cyan-100 active:scale-95 text-cyan-800 rounded-xl text-xs font-bold transition border border-cyan-200/80 shadow-xs"
          title="Campus Remote AC Override"
        >
          <Snowflake className="w-3.5 h-3.5 text-cyan-600" />
          <span>Blast AC</span>
        </button>
      </div>

      {/* Search Input Bar */}
      <div className="relative">
        <Search className="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" />
        <input
          type="text"
          value={searchQuery}
          onChange={(e) => setSearchQuery(e.target.value)}
          placeholder="Search classroom, staff, status..."
          className="w-full pl-9 pr-9 py-2.5 bg-white border border-slate-200 rounded-2xl text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-[#176e57] focus:ring-1 focus:ring-[#176e57] transition shadow-xs"
        />
        {searchQuery && (
          <button
            type="button"
            onClick={() => setSearchQuery('')}
            className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 p-0.5 rounded-full"
          >
            <X className="w-3.5 h-3.5" />
          </button>
        )}
      </div>

      {/* Floor Filter Row */}
      {!searchQuery && (
        <div className="flex flex-wrap gap-2 pt-0.5">
          {[1, 2, 3, 4, 5, 6, 7].map((f) => {
            const isActive = selectedFloor === f;
            return (
              <button
                key={f}
                onClick={() => setSelectedFloor(f)}
                className={`px-3.5 py-1.5 rounded-xl font-semibold text-xs transition active:scale-95 border ${
                  isActive
                    ? 'bg-[#176e57] text-white border-[#176e57] shadow-xs'
                    : 'bg-slate-100/80 text-slate-600 border-slate-200/60 hover:bg-slate-200/70'
                }`}
              >
                Floor {f}
              </button>
            );
          })}
        </div>
      )}

      {/* Floor Overview Card */}
      {!searchQuery ? (
        <div className="bg-white rounded-2xl p-3.5 border border-slate-100 shadow-[0_2px_8px_rgba(0,0,0,0.02)] flex items-center justify-between text-xs">
          <div className="flex items-center gap-2">
            <div className="w-8 h-8 rounded-xl bg-emerald-50 text-[#176e57] flex items-center justify-center font-bold">
              F{selectedFloor}
            </div>
            <div>
              <h3 className="font-bold text-slate-800">
                Floor {selectedFloor} Progress
              </h3>
              <p className="text-[10px] text-slate-400">
                Assigned Staff: <strong>{assignments[selectedFloor] || 'General Crew'}</strong>
              </p>
            </div>
          </div>

          <span className="text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200/60 px-2.5 py-1 rounded-xl">
            {floorCleaned} / 5 Done
          </span>
        </div>
      ) : (
        <div className="text-[11px] text-slate-500 px-1 font-medium">
          Found {floorRooms.length} classroom{floorRooms.length === 1 ? '' : 's'} matching "{searchQuery}"
        </div>
      )}

      {/* Classrooms List */}
      <div className="space-y-2.5">
        {floorRooms.length > 0 ? (
          floorRooms.map((room) => {
            const isReclean = room.status === 'needs_reclean';

            return (
              <div
                key={room.id}
                onClick={() => handleOpenRoomModal(room)}
                className="bg-white rounded-2xl p-3.5 border border-slate-100 shadow-[0_2px_8px_rgba(0,0,0,0.02)] hover:border-slate-300 transition active:scale-[0.99] cursor-pointer space-y-2.5"
              >
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className="text-sm font-bold text-slate-900">
                      Room {room.id}
                    </span>

                    {searchQuery && (
                      <span className="text-[10px] font-bold text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-200">
                        Floor {room.floor}
                      </span>
                    )}
                    
                    {room.hasStudents && (
                      <span className="text-[9px] font-bold bg-amber-50 text-amber-800 border border-amber-300 px-1.5 py-0.5 rounded-md flex items-center gap-1">
                        <Users className="w-2.5 h-2.5" />
                        <span>Class Active</span>
                      </span>
                    )}
                  </div>

                  <span
                    className={`text-[10px] font-bold px-2 py-0.5 rounded-full capitalize border ${
                      room.status === 'verified'
                        ? 'bg-blue-50 text-blue-700 border-blue-200'
                        : room.status === 'cleaned'
                        ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                        : isReclean
                        ? 'bg-rose-50 text-rose-700 border-rose-200'
                        : 'bg-slate-100 text-slate-600 border-slate-200'
                    }`}
                  >
                    {room.status ? room.status.replace('_', ' ') : 'Pending'}
                  </span>
                </div>

                {/* Status Checklist Badges */}
                <div className="flex items-center gap-3 text-[11px] text-slate-500 pt-1 border-t border-slate-50">
                  <span className={`flex items-center gap-1 ${room.acChecked ? 'text-emerald-700' : 'text-amber-600 font-medium'}`}>
                    <Power className="w-3.5 h-3.5" />
                    <span className="text-[10px]">{room.acChecked ? 'AC Off' : 'AC On'}</span>
                  </span>

                  <span className={`flex items-center gap-1 ${room.lightsChecked ? 'text-emerald-700' : 'text-amber-600 font-medium'}`}>
                    <Lightbulb className="w-3.5 h-3.5" />
                    <span className="text-[10px]">{room.lightsChecked ? 'Lights Off' : 'Lights On'}</span>
                  </span>

                  <span className={`flex items-center gap-1 ${room.doorChecked ? 'text-emerald-700' : 'text-slate-400'}`}>
                    <Lock className="w-3.5 h-3.5" />
                    <span className="text-[10px]">{room.doorChecked ? 'Locked' : 'Unlocked'}</span>
                  </span>

                  <span className="ml-auto text-[10px] font-mono text-slate-400">
                    {room.lastCleaned || '--:--'}
                  </span>
                </div>
              </div>
            );
          })
        ) : (
          <div className="bg-white rounded-2xl p-8 border border-slate-100 text-center space-y-2">
            <Building2 className="w-8 h-8 text-slate-300 mx-auto" />
            <p className="text-xs font-semibold text-slate-600">No classrooms found</p>
            <p className="text-[10px] text-slate-400">Try searching for another room number or name</p>
          </div>
        )}
      </div>

      {/* Room Inspection Modal */}
      {activeModalRoom && createPortal(
        <div 
          className="fixed inset-0 z-[120] bg-black/65 backdrop-blur-xs flex items-end sm:items-center justify-center sm:p-4 select-none"
          onClick={handleCloseRoomModal}
        >
          <div 
            className="bg-white w-full sm:max-w-md rounded-t-3xl sm:rounded-3xl shadow-2xl border border-slate-100 flex flex-col max-h-[85vh] sm:max-h-[88vh] animate-sheet-up overflow-hidden"
            onClick={(e) => e.stopPropagation()}
          >
            {/* Modal Header */}
            <div className="p-3.5 px-4 border-b border-slate-100 flex items-center justify-between flex-shrink-0">
              <div>
                <span className="text-[9px] font-bold text-slate-400 uppercase tracking-widest block">
                  Floor {activeModalRoom.floor} Checklist
                </span>
                <h3 className="text-base font-extrabold text-slate-900 leading-tight">
                  Inspect Room {activeModalRoom.id}
                </h3>
              </div>
              <button
                type="button"
                onClick={handleCloseRoomModal}
                className="p-1 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            {/* Scrollable Form Body */}
            <div className="p-3.5 px-4 overflow-y-auto space-y-3 text-xs flex-1">
              
              {/* 1. Students Occupancy Switch */}
              <div 
                onClick={() => setHasStudentsVal(!hasStudentsVal)}
                className={`p-2.5 rounded-2xl border flex items-center justify-between cursor-pointer active:scale-[0.99] transition ${
                  hasStudentsVal ? 'bg-amber-50 border-amber-300' : 'bg-slate-50 border-slate-200/70'
                }`}
              >
                <div className="flex items-center gap-2">
                  <div className={`p-1.5 rounded-xl ${hasStudentsVal ? 'bg-amber-100 text-amber-800' : 'bg-white text-slate-400 border border-slate-200'}`}>
                    <Users className="w-3.5 h-3.5" />
                  </div>
                  <div>
                    <span className="text-[11px] font-bold block text-slate-800">
                      Students Inside / Class in Session
                    </span>
                    <span className="text-[9px] text-slate-400 block">
                      Flags room as occupied to avoid disturbance
                    </span>
                  </div>
                </div>

                <div className={`w-5 h-5 rounded-lg flex items-center justify-center border transition ${
                  hasStudentsVal ? 'bg-amber-500 border-amber-500 text-white' : 'border-slate-300 bg-white'
                }`}>
                  {hasStudentsVal && <Check className="w-3 h-3 stroke-[3]" />}
                </div>
              </div>

              {/* 2. Cleanliness Status Selector */}
              <div>
                <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1.5">
                  Sanitation & Cleanliness:
                </label>
                <div className="grid grid-cols-2 gap-1.5">
                  {[
                    { id: 'pending', label: 'Pending', color: 'bg-slate-400' },
                    { id: 'cleaned', label: 'Cleaned', color: 'bg-emerald-600' },
                    { id: 'needs_reclean', label: 'Needs Reclean', color: 'bg-rose-600' },
                    { id: 'verified', label: 'Verified', color: 'bg-blue-600' }
                  ].map((s) => {
                    const isSelected = statusVal === s.id;
                    return (
                      <button
                        key={s.id}
                        type="button"
                        onClick={() => setStatusVal(s.id)}
                        className={`p-2 rounded-xl text-left font-bold text-xs transition border flex items-center gap-2 ${
                          isSelected
                            ? 'bg-[#176e57] text-white border-[#176e57] shadow-xs'
                            : 'bg-slate-50 text-slate-700 border-slate-200/80 hover:bg-slate-100'
                        }`}
                      >
                        <span className={`w-2 h-2 rounded-full ${isSelected ? 'bg-white' : s.color}`} />
                        <span>{s.label}</span>
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* Reclean Reason */}
              {statusVal === 'needs_reclean' && (
                <div className="space-y-1 animate-pop">
                  <label className="text-[10px] font-bold text-rose-600 uppercase tracking-wider block">
                    Reason for Reclean:
                  </label>
                  <input
                    type="text"
                    required
                    value={recleanReasonVal}
                    onChange={(e) => setRecleanReasonVal(e.target.value)}
                    placeholder="e.g. Muddy footprints, trash unemptied, spilled ink"
                    className="w-full p-2 text-xs border border-rose-300 rounded-xl bg-rose-50/50 text-rose-900 focus:outline-none focus:border-rose-500"
                  />
                </div>
              )}

              {/* 3. Safety & Energy Checklist */}
              <div>
                <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1.5">
                  Safety & Energy Checks:
                </label>
                <div className="space-y-1.5">
                  {[
                    { state: acVal, setter: setAcVal, icon: Power, label: 'Air Conditioning Switched OFF' },
                    { state: lightsVal, setter: setLightsVal, icon: Lightbulb, label: 'Classroom Lights Switched OFF' },
                    { state: doorVal, setter: setDoorVal, icon: Lock, label: 'Door Securely Locked' }
                  ].map((chk, idx) => {
                    return (
                      <div
                        key={idx}
                        onClick={() => chk.setter(!chk.state)}
                        className={`p-2 rounded-xl border flex items-center justify-between cursor-pointer active:scale-[0.99] transition ${
                          chk.state ? 'bg-emerald-50/60 border-emerald-200' : 'bg-slate-50 border-slate-200/80'
                        }`}
                      >
                        <div className="flex items-center gap-2">
                          <chk.icon className={`w-3.5 h-3.5 ${chk.state ? 'text-[#176e57]' : 'text-slate-400'}`} />
                          <span className={`text-[11px] font-semibold ${chk.state ? 'text-slate-800' : 'text-slate-500'}`}>
                            {chk.label}
                          </span>
                        </div>

                        <div className={`w-4 h-4 rounded-md flex items-center justify-center border transition ${
                          chk.state ? 'bg-[#176e57] border-[#176e57] text-white' : 'border-slate-300 bg-white'
                        }`}>
                          {chk.state && <Check className="w-2.5 h-2.5 stroke-[3]" />}
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>

              {/* 4. Notes & Incident Input */}
              <div>
                <label className="text-[10px] font-bold text-slate-400 uppercase tracking-wider block mb-1">
                  Room Notes & Incident Reports:
                </label>
                <textarea
                  rows={2}
                  value={notesVal}
                  onChange={(e) => setNotesVal(e.target.value)}
                  placeholder="Note physical damage, broken desks, or spills..."
                  className="w-full p-2 text-xs border border-slate-200 rounded-xl focus:outline-none focus:border-[#176e57] bg-slate-50 text-slate-800 resize-none"
                />
              </div>

            </div>

            {/* Bottom Actions Bar */}
            <div className="p-3 px-4 bg-white border-t border-slate-100 flex items-center gap-2 flex-shrink-0">
              <button
                type="button"
                onClick={handleCloseRoomModal}
                className="py-2.5 px-3 bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 font-bold rounded-xl text-xs transition"
              >
                Cancel
              </button>
              <button
                type="button"
                onClick={handleSaveInspection}
                disabled={isSaving}
                className="flex-1 py-2.5 bg-[#176e57] hover:bg-[#135c49] active:scale-95 text-white font-bold rounded-xl text-xs transition shadow-sm flex items-center justify-center gap-1.5"
              >
                <Check className="w-3.5 h-3.5" />
                <span>{isSaving ? 'Saving Room...' : 'Save Inspection'}</span>
              </button>
            </div>
          </div>
        </div>,
        document.body
      )}

      {/* Blast AC Modal Integration */}
      <BlastACModal
        isOpen={showBlastModal}
        onClose={() => setShowBlastModal(false)}
      />
    </div>
  );
}
</file>

<file path="src/components/Header.jsx">
import React, { useState, useRef, useEffect } from 'react';
import { useLocation, useNavigate } from 'react-router-dom';
import { supabase } from '../lib/supabase';
import { User, LogOut, X, Shield, Home, Grid, Package, ShieldCheck, Sparkles, KeyRound, MonitorSmartphone, Loader2, CheckCircle2, Megaphone } from 'lucide-react';

export default function Header({ user, setUser }) {
  const [isProfileOpen, setIsProfileOpen] = useState(false);
  const [showLogoutModal, setShowLogoutModal] = useState(false);
  const [broadcast, setBroadcast] = useState({ message: '', active: false });
  
  const [currentPassword, setCurrentPassword] = useState('');
  const [newPassword, setNewPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [passwordStatus, setPasswordStatus] = useState(null);
  const [isUpdatingPassword, setIsUpdatingPassword] = useState(false);

  const location = useLocation();
  const navigate = useNavigate();

  const desktopTabs = [
    { id: 'home', label: 'Dashboard', path: '/', icon: Home },
    { id: 'rooms', label: 'Rooms', path: '/rooms', icon: Grid },
    { id: 'supplies', label: 'Supplies', path: '/supplies', icon: Package },
  ];
  if (user?.role === 'admin') desktopTabs.push({ id: 'admin', label: 'Admin Workspace', path: '/admin', icon: ShieldCheck });

  const [dragY, setDragY] = useState(0);
  const touchStartY = useRef(0);
  const handleTouchStart = (e) => touchStartY.current = e.touches[0].clientY;
  const handleTouchMove = (e) => {
    const deltaY = e.touches[0].clientY - touchStartY.current;
    if (deltaY > 0) setDragY(deltaY);
  };
  const handleTouchEnd = () => {
    if (dragY > 75) setIsProfileOpen(false);
    setDragY(0);
  };

  useEffect(() => {
    const fetchInitialBroadcast = async () => {
      const { data } = await supabase.from('broadcast').select('*').eq('id', 1).maybeSingle();
      if (data) setBroadcast({ message: data.message, active: data.active });
    };
    fetchInitialBroadcast();

    const channel = supabase.channel('broadcast_changes')
      .on('postgres_changes', { event: 'UPDATE', schema: 'public', table: 'broadcast' }, (payload) => {
        if (payload.new.id === 1) {
          setBroadcast({ message: payload.new.message, active: payload.new.active });
        }
      })
      .subscribe();

    return () => { supabase.removeChannel(channel); };
  }, []);

  const handleLogout = () => {
    localStorage.removeItem('sjc_active_user');
    sessionStorage.removeItem('sjc_active_user');
    setUser(null);
    navigate('/');
  };

  const handleUpdatePassword = async () => {
    setPasswordStatus(null);
    if (!currentPassword || !newPassword || !confirmPassword) return setPasswordStatus({ type: 'error', msg: 'Please fill out all fields.' });
    if (newPassword !== confirmPassword) return setPasswordStatus({ type: 'error', msg: 'New passwords do not match.' });
    if (newPassword.length < 6) return setPasswordStatus({ type: 'error', msg: 'Password must be at least 6 characters.' });

    setIsUpdatingPassword(true);
    
    const { data: userData, error: fetchError } = await supabase.from('staff_credentials').select('password').eq('id', user.id).single();
    if (fetchError || !userData) {
      setIsUpdatingPassword(false);
      return setPasswordStatus({ type: 'error', msg: 'Could not verify current account.' });
    }
    if (userData.password !== currentPassword) {
      setIsUpdatingPassword(false);
      return setPasswordStatus({ type: 'error', msg: 'Current password does not match.' });
    }

    const { error: updateError } = await supabase.from('staff_credentials').update({ password: newPassword }).eq('id', user.id);
    if (updateError) {
      setPasswordStatus({ type: 'error', msg: 'Failed to update database.' });
    } else {
      setPasswordStatus({ type: 'success', msg: 'Password securely updated!' });
      setCurrentPassword(''); setNewPassword(''); setConfirmPassword('');
    }
    setIsUpdatingPassword(false);
  };

  return (
    <>
      <header className="sticky top-0 z-30 bg-[#176e57] text-white shadow-md">
        <div className="max-w-6xl mx-auto px-4 md:px-8 py-3 flex items-center justify-between">
          
          <div className="flex items-center gap-3 cursor-pointer" onClick={() => navigate('/')}>
            <div className="w-10 h-10 bg-white rounded-xl flex items-center justify-center shadow-sm p-1 overflow-hidden">
              <img src="/logo.png" alt="SJC Logo" className="w-full h-full object-contain" onError={(e) => { e.target.style.display = 'none'; e.target.nextSibling.style.display = 'block'; }} />
              <span style={{ display: 'none' }} className="text-[#176e57] font-black text-lg">SJC</span>
            </div>
            <div>
              <h1 className="text-base md:text-lg font-black leading-tight tracking-wide">PHINMA Saint Jude College</h1>
              <p className="text-[10px] md:text-xs text-emerald-100/90 font-bold">Inventory and Janitory Tracker</p>
            </div>
          </div>

          <nav className="hidden md:flex items-center gap-6">
            {desktopTabs.map((tab) => {
              const isActive = location.pathname === tab.path;
              const Icon = tab.icon;
              return (
                <button key={tab.id} onClick={() => navigate(tab.path)} className={`flex items-center gap-2 font-bold transition-all ${isActive ? tab.id === 'admin' ? 'text-amber-300 scale-105' : 'text-white scale-105' : 'text-emerald-200 hover:text-white'}`}>
                  <Icon className="w-4 h-4" /> <span className="text-sm">{tab.label}</span>
                </button>
              );
            })}
          </nav>

          <button onClick={() => setIsProfileOpen(true)} className="flex items-center gap-2.5 bg-white/10 hover:bg-white/20 px-3 py-1.5 rounded-full transition-colors border border-white/10">
            <div className="w-7 h-7 rounded-full bg-emerald-100 text-[#176e57] flex items-center justify-center text-sm font-bold">{user?.id ? user.id.slice(-2) : '00'}</div>
            <span className="text-sm font-bold max-w-[100px] truncate hidden sm:block">{user?.role === 'admin' ? 'Supervisor' : `Staff #${user?.id}`}</span>
          </button>
        </div>
      </header>

      {broadcast.active && (
        <div className="bg-amber-400 text-amber-900 px-4 py-2 text-center text-sm font-black flex items-center justify-center gap-2 animate-in slide-in-from-top shadow-md relative z-20 uppercase tracking-wide">
          <Megaphone className="w-4 h-4" />
          {broadcast.message}
        </div>
      )}

      {isProfileOpen && (
        <div className="fixed inset-0 z-50 flex flex-col justify-end md:justify-center md:items-center bg-slate-900/60 backdrop-blur-sm transition-opacity">
          <div className="flex-1 md:hidden" onClick={() => setIsProfileOpen(false)} />
          <div className="hidden md:block absolute inset-0" onClick={() => setIsProfileOpen(false)} />

          <div className="bg-white rounded-t-3xl md:rounded-3xl p-6 shadow-2xl transition-transform duration-200 flex flex-col max-w-md mx-auto w-full max-h-[85vh] relative z-10" style={{ transform: window.innerWidth < 768 ? `translateY(${dragY}px)` : 'none' }} onTouchStart={handleTouchStart} onTouchMove={handleTouchMove} onTouchEnd={handleTouchEnd}>
            <div className="md:hidden w-12 h-1.5 bg-slate-300 rounded-full mx-auto cursor-grab active:cursor-grabbing mb-4" />

            <div className="flex items-center justify-between pb-4 border-b border-slate-100 shrink-0">
              <div className="flex items-center gap-3">
                <div className="w-12 h-12 rounded-2xl bg-[#176e57]/10 text-[#176e57] flex items-center justify-center font-bold text-xl">
                  {user?.role === 'admin' ? <Shield className="w-6 h-6 text-amber-600" /> : <User className="w-6 h-6" />}
                </div>
                <div>
                  <h3 className="font-black text-slate-800 text-lg">{user?.name}</h3>
                  <p className="text-sm text-slate-500 capitalize font-medium">Assigned: Dimasalang F1</p>
                </div>
              </div>
              <button onClick={() => setIsProfileOpen(false)} className="p-2 bg-slate-100 text-slate-500 rounded-full hover:bg-slate-200"><X className="w-5 h-5" /></button>
            </div>

            <div className="overflow-y-auto space-y-4 py-4 pr-1 scrollbar-none">
              <div className="border border-slate-200 rounded-2xl p-4 space-y-3">
                <div className="flex items-center gap-2 text-[#176e57] mb-1">
                  <KeyRound className="w-5 h-5" />
                  <h4 className="font-bold text-slate-800 text-sm uppercase tracking-wide">Security & Password</h4>
                </div>
                
                {passwordStatus && (
                  <div className={`p-2.5 rounded-xl text-xs font-bold flex items-center gap-2 ${passwordStatus.type === 'error' ? 'bg-red-50 text-red-600 border border-red-100' : 'bg-emerald-50 text-emerald-700 border border-emerald-100'}`}>
                    {passwordStatus.type === 'success' ? <CheckCircle2 className="w-4 h-4" /> : <X className="w-4 h-4" />}
                    {passwordStatus.msg}
                  </div>
                )}

                <input type="password" placeholder="Current Password" value={currentPassword} onChange={(e) => setCurrentPassword(e.target.value)} className="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#176e57]" />
                <input type="password" placeholder="New Password (min 6 chars)" value={newPassword} onChange={(e) => setNewPassword(e.target.value)} className="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#176e57]" />
                <input type="password" placeholder="Confirm New Password" value={confirmPassword} onChange={(e) => setConfirmPassword(e.target.value)} className="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:ring-2 focus:ring-[#176e57]" />
                
                <button onClick={handleUpdatePassword} disabled={isUpdatingPassword} className="w-full py-2.5 bg-[#176e57] hover:bg-[#125744] text-white font-bold rounded-xl text-sm transition-colors flex justify-center items-center gap-2">
                  {isUpdatingPassword ? <><Loader2 className="w-4 h-4 animate-spin" /> Verifying...</> : 'Update Password'}
                </button>
              </div>
            </div>

            <div className="pt-4 border-t border-slate-100 shrink-0">
              <button onClick={() => setShowLogoutModal(true)} className="w-full py-3.5 bg-red-50 text-red-600 hover:bg-red-100 font-bold rounded-2xl text-sm flex items-center justify-center gap-2 transition-colors">
                <LogOut className="w-5 h-5" /> Log Out of Session
              </button>
            </div>
          </div>
        </div>
      )}

      {showLogoutModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl text-center space-y-4 relative z-50">
            <div className="w-14 h-14 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto"><LogOut className="w-7 h-7" /></div>
            <h3 className="font-black text-slate-800 text-xl">Confirm Sign Out</h3>
            <div className="flex gap-3 pt-2">
              <button onClick={() => setShowLogoutModal(false)} className="flex-1 py-3 bg-slate-100 text-slate-700 rounded-xl font-bold hover:bg-slate-200">Cancel</button>
              <button onClick={handleLogout} className="flex-1 py-3 bg-red-600 text-white rounded-xl font-bold hover:bg-red-700">Sign Out</button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}
